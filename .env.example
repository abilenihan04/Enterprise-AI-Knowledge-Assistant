# Copy this file to .env and fill in your own values. .env is git-ignored.

# Local PostgreSQL started with `docker compose up -d`:
DATABASE_URL=postgresql://knowledge:knowledge@localhost:5432/knowledge_assistant

# Hosted PostgreSQL (e.g. Neon/Supabase) - paste the connection string they give you:
# DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Local language model used to write answers (Ollama, https://ollama.com):
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b
